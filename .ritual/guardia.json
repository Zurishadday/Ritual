{
  "integradas": ["python-c", "python-sin-archivo", "node-e-diagonales", "heredoc-diagonales", "sed-i-codigo"],
  "reglas": [
    {
      "nombre": "push-forzado-a-main",
      "patron": "git\\s+push\\b[^\\n]*(--force|-f\\b)[^\\n]*\\b(main|master)\\b",
      "mensaje": "A forced push to main rewrites shared history. Push to a branch and open a pull request.",
      "bloquea": ["git push --force origin main", "git push -f origin master"],
      "deja": ["git push origin main", "git push --force-with-lease origin mi-rama", "git push -f origin mi-rama"]
    },
    {
      "nombre": "veredicto-por-tail",
      "patron": "^(?![\\s\\S]*pipefail)[\\s\\S]*(?<![\\w-])(npm test|--probar|--verificar)(?![\\w-])[^|\\n]*\\|\\s*(tail|head|grep)\\b",
      "mensaje": "Piping a test through tail/head/grep hides its verdict: the exit code becomes the pipe's (lesson 44, P-1). Start the command with `set -o pipefail &&`.",
      "bloquea": ["npm test --silent 2>&1 | tail -4 && git commit -m x", "node scripts/lecciones.mjs --verificar | grep problema", "node hooks/guardia.mjs --probar 2>&1 | head -5"],
      "deja": ["set -o pipefail && npm test --silent 2>&1 | tail -4", "npm test", "git log --oneline | head -3", "node scripts/lecciones.mjs --verificar", "npm test > salida.txt; grep -c '✓' salida.txt"]
    }
  ]
}
